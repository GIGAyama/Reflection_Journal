{
  "name": "ふりかえりジャーナル",
  "short_name": "ジャーナル案内",
  "description": "ふりかえりジャーナルの導入案内。スプレッドシートをコピーして、先生ご自身のアカウントで公開する手順を載せています。",
  "lang": "ja",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "minimal-ui",
  "display_override": [
    "minimal-ui",
    "browser"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#a5410a",
  "categories": [
    "education",
    "kids"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
